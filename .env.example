PORT=3001
DATABASE_PATH=./server/data/app.db

# Unsplash API — register an app at https://unsplash.com/oauth/applications
# and paste your Access Key here. Stays server-side; never sent to the client.
UNSPLASH_ACCESS_KEY=<your-unsplash-access-key>
UNSPLASH_BASE_URL=https://api.unsplash.com

# Client — base path for API calls. In dev, Vite proxies /api to the server.
VITE_API_BASE=/api
